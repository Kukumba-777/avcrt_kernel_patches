index 9d3ce8e03f497555e07152e8cd390dee773852c9..a8d4f95b88b96d86165ac112bdcc7e62eefdc750 100755
--- a/qcom/opensource/audio-kernel/ipc/audio-pkt.c
+++ b/qcom/opensource/audio-kernel/ipc/audio-pkt.c
@@ -27,10 +27,16 @@
 #include <linux/fs.h>
 #include <linux/uaccess.h>
 #include <linux/termios.h>
+#include <linux/completion.h>
+#include <linux/workqueue.h>
+#include <asm/unaligned.h>
 #include <ipc/gpr-lite.h>
 #include <dsp/spf-core.h>
 #include <dsp/msm_audio_ion.h>
 
+#define CREATE_TRACE_POINTS
+#include "avcrt-spf-trace.h"
+
 /* Define IPC Logging Macros */
 #define AUDIO_PKT_IPC_LOG_PAGE_CNT 2
 static void *audio_pkt_ilctxt;
@@ -65,6 +71,196 @@ do {									      \
 #define CHANNEL_NAME "adsp_apps"
 #define MAX_PACKET_SIZE 4096
 
+/* Public AudioReach APM/VCPM wire IDs; never card, DSP instance, or VSID values. */
+#define AVCRT_APM_GRAPH_OPEN		0x01001000
+#define AVCRT_APM_GRAPH_CLOSE		0x01001004
+#define AVCRT_APM_SET_CFG		0x01001006
+#define AVCRT_APM_GET_CFG		0x01001007
+#define AVCRT_APM_SUB_GRAPH_LIST	0x08001005
+#define AVCRT_CODEC_DMA_INTF_CFG	0x08001063
+#define AVCRT_VCPM_VOICE_CONFIG		0x08001162
+#define AVCRT_VCPM_VSID			0x080011BC
+#define AVCRT_VCPM_TX_PP_CHANNEL_INFO	0x08001310
+#define AVCRT_VCPM_TAG_INFO		0x080011B2
+#define AVCRT_VOICE_ENCODER_TAG		0x08001177
+#define AVCRT_VOICE_TX_HPCM_TAG		0x08001179
+
+#include "avcrt-spf-voice.h"
+
+/* AudioReach shared-memory endpoint opcodes; trace only GPR headers. */
+static bool avcrt_spf_data_opcode(bool tx, u32 opcode)
+{
+	if (tx)
+		return opcode == 0x04001000 || /* write buffer */
+		       opcode == 0x04001003 || /* read buffer */
+		       opcode == 0x0400100A || /* write buffer v2 */
+		       opcode == 0x0400100B;   /* read buffer v2 */
+	return opcode == 0x05001000 || /* write done */
+	       opcode == 0x05001002 || /* read done */
+	       opcode == 0x05001004 || /* write done v2 */
+	       opcode == 0x05001005;   /* read done v2 */
+}
+
+/* Emit only encoder and TX HPCM tags, not arbitrary parameter data. */
+static void avcrt_trace_voice_tags(u32 token, const u8 *p, size_t len)
+{
+	u32 graphs, props, sgid, id, size, tags, i;
+
+	if (len < 4)
+		return;
+	graphs = get_unaligned_le32(p);
+	p += 4;
+	len -= 4;
+	while (graphs--) {
+		if (len < 8)
+			return;
+		sgid = get_unaligned_le32(p);
+		props = get_unaligned_le32(p + 4);
+		p += 8;
+		len -= 8;
+		while (props--) {
+			if (len < 8)
+				return;
+			id = get_unaligned_le32(p);
+			size = get_unaligned_le32(p + 4);
+			p += 8;
+			len -= 8;
+			if (size > len)
+				return;
+			if (id == AVCRT_VCPM_TAG_INFO && size >= 4) {
+				tags = get_unaligned_le32(p);
+				if (tags <= (size - 4) / 8) {
+					for (i = 0; i < tags; i++) {
+						const u8 *t = p + 4 + i * 8;
+						u32 tag = get_unaligned_le32(t);
+
+						if (tag == AVCRT_VOICE_TX_HPCM_TAG ||
+						    tag == AVCRT_VOICE_ENCODER_TAG)
+							trace_avcrt_spf_config(token, tag,
+									      get_unaligned_le32(t + 4), sgid, 0, 0);
+					}
+				}
+			}
+			p += size;
+			len -= size;
+		}
+	}
+}
+
+static void avcrt_trace_spf_config(u32 token, u32 opcode, u32 peer,
+				   const u8 *p, size_t len)
+{
+	u32 miid, id, size, error, step;
+
+	/* APM command header: only documented in-band parameters, never DMA. */
+	if (len < 16 || get_unaligned_le32(p) || get_unaligned_le32(p + 4) ||
+	    get_unaligned_le32(p + 8))
+		return;
+	if (get_unaligned_le32(p + 12) > len - 16)
+		return;
+	len = get_unaligned_le32(p + 12);
+	p += 16;
+	while (len >= 16) {
+		miid = get_unaligned_le32(p);
+		id = get_unaligned_le32(p + 4);
+		size = get_unaligned_le32(p + 8);
+		error = get_unaligned_le32(p + 12);
+		p += 16;
+		len -= 16;
+		if (size > len)
+			return;
+		step = ALIGN(size, 8);
+		if (step > len)
+			return;
+		if (id == AVCRT_APM_SUB_GRAPH_LIST && size >= 4) {
+			u32 n = get_unaligned_le32(p), i;
+
+			if (n <= (size - 4) / 4)
+				for (i = 0; i < n; i++)
+					trace_avcrt_spf_config(token, id, miid,
+							      get_unaligned_le32(p + 4 + i * 4), 0, 0);
+		} else if (id == AVCRT_VCPM_VOICE_CONFIG) {
+			trace_avcrt_spf_config(token, id, miid, size, 0, 0);
+			avcrt_trace_voice_tags(token, p, size);
+		} else if (id == AVCRT_VCPM_TX_PP_CHANNEL_INFO &&
+			   opcode == AVCRT_APM_SET_CFG && !error &&
+			   peer == AVCRT_VCPM_PORT && miid == AVCRT_VCPM_PORT &&
+			   size == 8 && get_unaligned_le32(p) && get_unaligned_le32(p + 4)) {
+			/* VSID and channel count, not a VSID SET or a graph ownership ACK. */
+			trace_avcrt_spf_config(token, id, miid, get_unaligned_le32(p),
+					      get_unaligned_le32(p + 4), 0);
+		} else if (id == AVCRT_VCPM_VSID && size == 4)
+			trace_avcrt_spf_config(token, id, miid, get_unaligned_le32(p), 0, 0);
+		else if (id == AVCRT_CODEC_DMA_INTF_CFG && size == 12)
+			trace_avcrt_spf_config(token, id, miid, get_unaligned_le32(p),
+					      get_unaligned_le32(p + 4), get_unaligned_le32(p + 8));
+		else if (id == AVCRT_USB_AUDIO_INTF_CFG && opcode == AVCRT_APM_SET_CFG &&
+			 miid && peer == miid && !error && size == 8)
+			trace_avcrt_spf_config(token, id, miid, get_unaligned_le32(p),
+					      get_unaligned_le32(p + 4), 0);
+		p += step;
+		len -= step;
+	}
+}
+
+static void avcrt_trace_audio_pkt(bool tx, const struct gpr_hdr *hdr, size_t len,
+				 int transport_ret)
+{
+	u32 opcode, type, token, hdr_size, pkt_size, reply_opcode = 0;
+	const u8 *payload;
+	size_t payload_size;
+	s32 status = transport_ret;
+
+	if (!trace_avcrt_spf_packet_enabled() && !trace_avcrt_spf_config_enabled() &&
+	    !trace_avcrt_spf_apm_enabled() && !trace_avcrt_spf_data_enabled())
+		return;
+	if (len < sizeof(*hdr))
+		return;
+	hdr_size = GPR_PKT_GET_HEADER_BYTE_SIZE(hdr->header);
+	pkt_size = GPR_PKT_GET_PACKET_BYTE_SIZE(hdr->header);
+	if (hdr_size < sizeof(*hdr) || hdr_size > pkt_size || pkt_size > len ||
+	    pkt_size > MAX_PACKET_SIZE)
+		return;
+	opcode = hdr->opcode;
+	type = (opcode & MM_GUID_TYPE_MASK) >> MM_GUID_TYPE_SHIFT;
+	if (trace_avcrt_spf_data_enabled() && avcrt_spf_data_opcode(tx, opcode)) {
+		trace_avcrt_spf_data(tx, hdr->src_domain_id, hdr->dst_domain_id,
+				     hdr->src_port, hdr->dst_port, hdr->token,
+				     opcode, transport_ret);
+		return;
+	}
+	if (type < MM_GUID_TYPE_CONTROL_CMD || type > MM_GUID_TYPE_CONTROL_EVENT)
+		return;
+	token = hdr->token;
+	payload = (const u8 *)hdr + hdr_size;
+	payload_size = pkt_size - hdr_size;
+	if (!tx && opcode == GPR_IBASIC_RSP_RESULT && payload_size >= 8) {
+		reply_opcode = get_unaligned_le32(payload);
+		status = get_unaligned_le32(payload + 4);
+	}
+	trace_avcrt_spf_packet(tx, hdr->src_domain_id, hdr->dst_domain_id, hdr->src_port,
+			       hdr->dst_port, token, opcode, pkt_size, reply_opcode, status);
+	if (tx && trace_avcrt_spf_apm_enabled() && payload_size >= 16 &&
+	    ((opcode >= AVCRT_APM_GRAPH_OPEN && opcode <= AVCRT_APM_GRAPH_CLOSE) ||
+	     opcode == AVCRT_APM_SET_CFG || opcode == AVCRT_APM_GET_CFG)) {
+		bool shared = get_unaligned_le32(payload) ||
+			      get_unaligned_le32(payload + 4) ||
+			      get_unaligned_le32(payload + 8);
+		u32 declared = get_unaligned_le32(payload + 12);
+
+		/* No address or handle is exported, and shared memory is not mapped. */
+		trace_avcrt_spf_apm(hdr->src_domain_id, hdr->dst_domain_id,
+				    hdr->src_port, hdr->dst_port, token, opcode,
+				    shared, declared, (u32)payload_size - 16);
+	}
+	if (tx && transport_ret >= 0 && trace_avcrt_spf_config_enabled() &&
+	    ((opcode >= AVCRT_APM_GRAPH_OPEN && opcode <= AVCRT_APM_GRAPH_CLOSE) ||
+	     opcode == AVCRT_APM_SET_CFG))
+		avcrt_trace_spf_config(token, opcode, hdr->dst_port, payload, payload_size);
+}
+
+
+#include "avcrt-spf-usb-cut.h"
 
 enum audio_pkt_state {
 	AUDIO_PKT_INIT,
@@ -195,7 +391,11 @@ int audio_pkt_release(struct inode *inode, struct file *file)
 	spin_unlock_irqrestore(&audpkt_dev->queue_lock, flags);
 
 	file->private_data = NULL;
+	mutex_lock(&avcrt_cut_lock);
+	avcrt_cut_rollback(AVCRT_CUT_RELEASED);
+	avcrt_voice_reset();
 	spf_core_apm_close_all();
+	mutex_unlock(&avcrt_cut_lock);
 	msm_audio_ion_crash_handler();
 
 	return 0;
@@ -340,7 +540,7 @@ ssize_t audio_pkt_write(struct file *file, const char __user *buf,
 	struct audio_pkt_device *audpkt_dev = NULL;
 	struct gpr_hdr *audpkt_hdr = NULL;
 	void *kbuf;
-	int ret;
+	int ret, cut_slot;
 
 	if (file == NULL || file->private_data == NULL || buf == NULL) {
 		AUDIO_PKT_ERR("invalid parameters\n");
@@ -372,6 +572,10 @@ ssize_t audio_pkt_write(struct file *file, const char __user *buf,
 		return PTR_ERR(kbuf);
 
 	audpkt_hdr = (struct gpr_hdr *) kbuf;
+	if (audpkt_hdr->src_port == AVCRT_CUT_PORT) {
+		ret = -EINVAL;
+		goto free_kbuf;
+	}
 
 	/* validate packet size */
 	if ((count > MAX_PACKET_SIZE) || (count < GPR_PKT_GET_PACKET_BYTE_SIZE(audpkt_hdr->header)))
@@ -393,17 +597,35 @@ ssize_t audio_pkt_write(struct file *file, const char __user *buf,
 		}
 	}
 
-	if (mutex_lock_interruptible(&audpkt_dev->lock)) {
+	if (mutex_lock_interruptible(&avcrt_cut_lock)) {
 		ret = -ERESTARTSYS;
 		goto free_kbuf;
 	}
+	if (!avcrt_cut_adev) {
+		ret = -ENETRESET;
+		goto unlock_cut;
+	}
+	if (mutex_lock_interruptible(&audpkt_dev->lock)) {
+		ret = -ERESTARTSYS;
+		goto unlock_cut;
+	}
 	if (count < sizeof(struct gpr_pkt )) {
 		AUDIO_PKT_ERR("Invalid count %zu\n", count);
 		ret = -EINVAL;
 		mutex_unlock(&audpkt_dev->lock);
-		goto free_kbuf;
+		goto unlock_cut;
+	}
+	cut_slot = avcrt_cut_stock_before(audpkt_hdr);
+	/* Publish the pending request before an ACK can arrive on another CPU. */
+	avcrt_voice_observe(true, audpkt_hdr, count, false);
+	avcrt_usb_capture_tx(audpkt_hdr, false);
+	ret = gpr_send_pkt(avcrt_cut_adev, (struct gpr_pkt *)kbuf);
+	if (ret < 0) {
+		avcrt_usb_capture_tx(audpkt_hdr, true);
+		avcrt_cut_stock_failed(cut_slot);
+		avcrt_voice_observe(true, audpkt_hdr, count, true);
 	}
-	ret = gpr_send_pkt(ap_priv->adev,(struct gpr_pkt *) kbuf);
+	avcrt_trace_audio_pkt(true, audpkt_hdr, count, ret < 0 ? ret : 0);
 	if (ret < 0) {
 		AUDIO_PKT_ERR("APR Send Packet Failed ret -%d\n", ret);
 		if (ret == -ECONNRESET)
@@ -411,6 +633,8 @@ ssize_t audio_pkt_write(struct file *file, const char __user *buf,
 	}
 	mutex_unlock(&audpkt_dev->lock);
 
+unlock_cut:
+	mutex_unlock(&avcrt_cut_lock);
 free_kbuf:
 	kfree(kbuf);
 	return ret < 0 ? ret : count;
@@ -481,6 +705,12 @@ static int audio_pkt_srvc_callback(struct gpr_device *adev,
     AUDIO_PKT_INFO("%s: header %d packet %d \n",
 		__func__,hdr_size, pkt_size);
 
+	avcrt_trace_audio_pkt(false, hdr, pkt_size, 0);
+	if (avcrt_cut_rx(hdr, pkt_size))
+		return 0;
+	avcrt_voice_observe(false, hdr, pkt_size, false);
+	avcrt_cut_stock_ack(hdr, pkt_size);
+	avcrt_usb_capture_ack(hdr, pkt_size);
 	skb = alloc_skb(pkt_size, GFP_ATOMIC);
 	if (!skb) {
 		AUDIO_PKT_ERR("[TF-STABILITY]:alloc skb pkt_size %d failed\n", pkt_size);
@@ -518,6 +748,9 @@ static int audio_pkt_probe(struct gpr_device *adev)
 		mutex_unlock(&ap_priv->lock);
 
 		dev_set_drvdata(&adev->dev, ap_priv);
+		mutex_lock(&avcrt_cut_lock);
+		avcrt_cut_adev = adev;
+		mutex_unlock(&avcrt_cut_lock);
 
 		dev_dbg(&adev->dev, "%s: Driver[%s] Probed\n",
 		 __func__, adev->name);
@@ -545,6 +778,11 @@ static int audio_pkt_probe(struct gpr_device *adev)
  */
 static int audio_pkt_remove(struct gpr_device *adev)
 {
+	mutex_lock(&avcrt_cut_lock);
+	avcrt_cut_adev = NULL;
+	avcrt_cut_rollback(AVCRT_CUT_GPR_REMOVED);
+	avcrt_voice_reset();
+	mutex_unlock(&avcrt_cut_lock);
 	if(ap_priv)
 	{
 		mutex_lock(&ap_priv->lock);
@@ -755,6 +993,7 @@ static int __init audio_pkt_init(void)
 static void __exit audio_pkt_exit(void)
 {
 	platform_driver_unregister(&audio_pkt_core_platform_driver);
+	cancel_delayed_work_sync(&avcrt_cut_timer);
 }
 module_init(audio_pkt_init);
 module_exit(audio_pkt_exit);
diff --git a/qcom/opensource/audio-kernel/ipc/avcrt-spf-trace.h b/qcom/opensource/audio-kernel/ipc/avcrt-spf-trace.h
