+	TP_printk("token=%08x id=%08x miid=%08x value0=%08x value1=%08x value2=%08x",
+		  __entry->token, __entry->id, __entry->miid, __entry->value0,
+		  __entry->value1, __entry->value2)
+);
+
+TRACE_EVENT(avcrt_spf_apm,
+	TP_PROTO(u8 src_domain, u8 dst_domain, u32 src_port, u32 dst_port,
+		 u32 token, u32 opcode, bool shared, u32 declared, u32 inline_bytes),
+	TP_ARGS(src_domain, dst_domain, src_port, dst_port, token, opcode,
+		shared, declared, inline_bytes),
+	TP_STRUCT__entry(
+		__field(u8, src_domain)
+		__field(u8, dst_domain)
+		__field(u32, src_port)
+		__field(u32, dst_port)
+		__field(u32, token)
+		__field(u32, opcode)
+		__field(bool, shared)
+		__field(u32, declared)
+		__field(u32, inline_bytes)
