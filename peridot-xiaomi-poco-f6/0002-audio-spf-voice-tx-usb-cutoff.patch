index 0000000000000000000000000000000000000000..83fe3ef2060b72bd91d7402b7937d321cd0cd6fe
--- /dev/null
+++ b/qcom/opensource/audio-kernel/ipc/avcrt-spf-trace.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM avcrt_spf
+
+#if !defined(_AVCRT_SPF_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _AVCRT_SPF_TRACE_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(avcrt_spf_packet,
+	TP_PROTO(bool tx, u8 src_domain, u8 dst_domain, u32 src_port, u32 dst_port,
+		 u32 token, u32 opcode, u32 bytes, u32 reply_opcode, s32 status),
+	TP_ARGS(tx, src_domain, dst_domain, src_port, dst_port, token, opcode, bytes,
+		reply_opcode, status),
+	TP_STRUCT__entry(
+		__field(bool, tx)
+		__field(u8, src_domain)
+		__field(u8, dst_domain)
+		__field(u32, src_port)
+		__field(u32, dst_port)
+		__field(u32, token)
+		__field(u32, opcode)
+		__field(u32, bytes)
+		__field(u32, reply_opcode)
+		__field(s32, status)
+	),
+	TP_fast_assign(
+		__entry->tx = tx;
+		__entry->src_domain = src_domain;
+		__entry->dst_domain = dst_domain;
+		__entry->src_port = src_port;
+		__entry->dst_port = dst_port;
+		__entry->token = token;
+		__entry->opcode = opcode;
+		__entry->bytes = bytes;
+		__entry->reply_opcode = reply_opcode;
+		__entry->status = status;
+	),
+	TP_printk("%s %u:%08x->%u:%08x token=%08x op=%08x bytes=%u reply_op=%08x status=%d",
+		  __entry->tx ? "TX" : "RX", __entry->src_domain, __entry->src_port,
+		  __entry->dst_domain, __entry->dst_port, __entry->token, __entry->opcode,
+		  __entry->bytes, __entry->reply_opcode, __entry->status)
+);
+
+TRACE_EVENT(avcrt_spf_config,
+	TP_PROTO(u32 token, u32 id, u32 miid, u32 value0, u32 value1, u32 value2),
+	TP_ARGS(token, id, miid, value0, value1, value2),
+	TP_STRUCT__entry(
+		__field(u32, token)
+		__field(u32, id)
+		__field(u32, miid)
+		__field(u32, value0)
+		__field(u32, value1)
+		__field(u32, value2)
+	),
+	TP_fast_assign(
