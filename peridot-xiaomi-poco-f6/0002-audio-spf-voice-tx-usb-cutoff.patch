+		__entry->src_domain = src_domain;
+		__entry->dst_domain = dst_domain;
+		__entry->src_port = src_port;
+		__entry->dst_port = dst_port;
+		__entry->token = token;
+		__entry->opcode = opcode;
+		__entry->shared = shared;
+		__entry->declared = declared;
+		__entry->inline_bytes = inline_bytes;
+	),
+	TP_printk("%u:%08x->%u:%08x token=%08x op=%08x shared=%u declared=%u inline=%u",
+		  __entry->src_domain, __entry->src_port, __entry->dst_domain,
+		  __entry->dst_port, __entry->token, __entry->opcode, __entry->shared,
+		  __entry->declared, __entry->inline_bytes)
+);
+
+TRACE_EVENT(avcrt_spf_data,
+	TP_PROTO(bool tx, u8 src_domain, u8 dst_domain, u32 src_port, u32 dst_port,
+		 u32 token, u32 opcode, s32 transport_ret),
+	TP_ARGS(tx, src_domain, dst_domain, src_port, dst_port, token, opcode, transport_ret),
+	TP_STRUCT__entry(
+		__field(bool, tx)
+		__field(u8, src_domain)
+		__field(u8, dst_domain)
+		__field(u32, src_port)
+		__field(u32, dst_port)
+		__field(u32, token)
+		__field(u32, opcode)
+		__field(s32, transport_ret)
+	),
+	TP_fast_assign(
+		__entry->tx = tx;
+		__entry->src_domain = src_domain;
+		__entry->dst_domain = dst_domain;
+		__entry->src_port = src_port;
+		__entry->dst_port = dst_port;
+		__entry->token = token;
+		__entry->opcode = opcode;
+		__entry->transport_ret = transport_ret;
+	),
+	TP_printk("%s %u:%08x->%u:%08x token=%08x op=%08x transport_ret=%d",
+		  __entry->tx ? "TX" : "RX", __entry->src_domain, __entry->src_port,
