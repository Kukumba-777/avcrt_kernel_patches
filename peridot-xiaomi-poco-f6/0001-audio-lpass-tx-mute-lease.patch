+	if (dec >= widget->num_kcontrols)
+		return AVCRT_ALL_DECS;
+	ctl = &widget->kcontrol_news[dec];
+	if (ctl->private_value != kcontrol->private_value)
+		return AVCRT_ALL_DECS;
