 #define NUM_DECIMATORS 8
+#define TX_PGA_MUTE_MASK 0x10
+#define AVCRT_MUTE_LEASE_MS 250
+#define AVCRT_MUTE_RETRY_MS 20
 
 #define LPASS_CDC_TX_MACRO_RATES (SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |\
 			SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000 |\
@@ -152,7 +157,20 @@ struct hpf_work {
 
 struct lpass_cdc_tx_macro_priv {
 	struct device *dev;
-	bool dec_active[NUM_DECIMATORS];
+	/* DAPM power events, not the capture AIF routing switches. */
+	unsigned long avcrt_dec_power;
+	/* Serializes mute ownership, timeout, startup unmute and PRE_PMD. */
+	struct mutex avcrt_lock;
+	unsigned long avcrt_dec_ready;
+	unsigned long avcrt_test_mute;
+	unsigned long avcrt_dec_mute;
+	struct delayed_work avcrt_mute_work;
+	unsigned long avcrt_mute_deadline;
+	unsigned int avcrt_route_updates;
+	bool avcrt_attached;
+	bool avcrt_ssr_down;
+	bool avcrt_suspended;
+	bool avcrt_revoked;
 	int tx_mclk_users;
 	bool dapm_mclk_enable;
 	struct mutex mclk_lock;
@@ -232,6 +250,338 @@ static bool lpass_cdc_tx_macro_get_data(struct snd_soc_component *component,
 	return true;
 }
 
+static int lpass_cdc_tx_macro_avcrt_power_get(struct snd_kcontrol *kcontrol,
+					     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+	struct lpass_cdc_tx_macro_priv *tx_priv;
+	struct device *tx_dev;
+
+	if (!lpass_cdc_tx_macro_get_data(component, &tx_dev, &tx_priv, __func__))
+		return -EINVAL;
+
+	ucontrol->value.integer.value[0] = READ_ONCE(tx_priv->avcrt_dec_power);
+	return 0;
+}
+
+static int lpass_cdc_tx_macro_avcrt_mute_get(struct snd_kcontrol *kcontrol,
+						   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+	struct lpass_cdc_tx_macro_priv *tx_priv;
+	struct device *tx_dev;
+
+	if (!lpass_cdc_tx_macro_get_data(component, &tx_dev, &tx_priv, __func__))
+		return -EINVAL;
+
+	mutex_lock(&tx_priv->avcrt_lock);
+	ucontrol->value.integer.value[0] = tx_priv->avcrt_test_mute;
+	mutex_unlock(&tx_priv->avcrt_lock);
+	return 0;
+}
+
+static unsigned long lpass_cdc_tx_avcrt_mask(struct lpass_cdc_tx_macro_priv *tx)
+{
+	return tx->avcrt_dec_mute | tx->avcrt_test_mute;
+}
+
+/* avcrt_lock held. Retry only decimators which may still be muted by us. */
+static int lpass_cdc_tx_avcrt_release(struct lpass_cdc_tx_macro_priv *tx)
+{
+	unsigned long mask = lpass_cdc_tx_avcrt_mask(tx);
+	unsigned int dec;
+	int err = 0;
+
+	for_each_set_bit(dec, &mask, NUM_DECIMATORS) {
+		u16 reg = LPASS_CDC_TX0_TX_PATH_CTL +
+			LPASS_CDC_TX_MACRO_TX_PATH_OFFSET * dec;
+		int ret;
+
+		/* Force the write: a failed earlier write may have updated cache. */
+		ret = regmap_write_bits(tx->component->regmap, reg, TX_PGA_MUTE_MASK, 0);
+		if (ret < 0) {
+			err = ret;
+			continue;
+		}
+		clear_bit(dec, &tx->avcrt_dec_mute);
+		clear_bit(dec, &tx->avcrt_test_mute);
+	}
+	if (err < 0) {
+		dev_err_ratelimited(tx->dev, "AVCRT unmute failed, pending DEC mask %#lx: %d\n",
+				    lpass_cdc_tx_avcrt_mask(tx), err);
+		if (tx->avcrt_attached && !tx->avcrt_ssr_down && !tx->avcrt_suspended)
+			mod_delayed_work(system_wq, &tx->avcrt_mute_work,
+					 msecs_to_jiffies(AVCRT_MUTE_RETRY_MS));
+	} else {
+		cancel_delayed_work(&tx->avcrt_mute_work);
+	}
+	return err;
+}
+
+static int lpass_cdc_tx_avcrt_revoke(struct lpass_cdc_tx_macro_priv *tx)
+{
+	if (!lpass_cdc_tx_avcrt_mask(tx))
+		return 0;
+	tx->avcrt_revoked = true;
+	return lpass_cdc_tx_avcrt_release(tx);
+}
+
+static void lpass_cdc_tx_avcrt_timeout(struct work_struct *work)
+{
+	struct lpass_cdc_tx_macro_priv *tx = container_of(to_delayed_work(work),
+			struct lpass_cdc_tx_macro_priv, avcrt_mute_work);
+	unsigned long now;
+
+	mutex_lock(&tx->avcrt_lock);
+	if (!tx->avcrt_attached || tx->avcrt_ssr_down || tx->avcrt_suspended ||
+	    !lpass_cdc_tx_avcrt_mask(tx))
+		goto out;
+	now = jiffies;
+	if (!tx->avcrt_revoked && time_before(now, tx->avcrt_mute_deadline))
+		mod_delayed_work(system_wq, &tx->avcrt_mute_work, tx->avcrt_mute_deadline - now);
+	else
+		lpass_cdc_tx_avcrt_revoke(tx);
+out:
+	mutex_unlock(&tx->avcrt_lock);
+}
+
+#define AVCRT_ALL_DECS GENMASK(NUM_DECIMATORS - 1, 0)
+
+/* Do not hold avcrt_lock across DAPM; its widget events take the same lock. */
+static void lpass_cdc_tx_avcrt_route_begin(struct lpass_cdc_tx_macro_priv *tx,
+					 unsigned long affected, const char *control)
+{
+	mutex_lock(&tx->avcrt_lock);
+	tx->avcrt_route_updates++;
+	if (lpass_cdc_tx_avcrt_mask(tx) & affected) {
+		dev_info_ratelimited(tx->dev, "AVCRT TX mute revoked: %s (affected DEC %#lx, lease %#lx)\n",
+				     control, affected, lpass_cdc_tx_avcrt_mask(tx));
+		lpass_cdc_tx_avcrt_revoke(tx);
+	}
+	mutex_unlock(&tx->avcrt_lock);
+}
+
+static void lpass_cdc_tx_avcrt_route_end(struct lpass_cdc_tx_macro_priv *tx)
+{
+	mutex_lock(&tx->avcrt_lock);
+	tx->avcrt_route_updates--;
+	mutex_unlock(&tx->avcrt_lock);
+}
+
+static int lpass_cdc_tx_avcrt_mux_dec(unsigned int reg, unsigned int base)
+{
+	unsigned int offset;
+
+	if (reg < base)
+		return -EINVAL;
+	offset = reg - base;
+	if (offset % LPASS_CDC_TX_MACRO_ADC_MUX_CFG_OFFSET ||
+	    offset / LPASS_CDC_TX_MACRO_ADC_MUX_CFG_OFFSET >= NUM_DECIMATORS)
+		return -EINVAL;
+	return offset / LPASS_CDC_TX_MACRO_ADC_MUX_CFG_OFFSET;
+}
+
+/* ALSA serializes these put callbacks, including lease writes, under
+ * controls_rwsem. Take the DAPM mutex for the cache snapshot, but drop it
+ * before calling the stock DAPM handler. DEC power-down/SSR can still revoke
+ * the lease through their own hooks.
+ */
+static unsigned long lpass_cdc_tx_avcrt_enum_affected(struct snd_kcontrol *kcontrol,
+						     struct snd_soc_dapm_widget *widget,
+						     unsigned int item, int dec,
+						     unsigned int mic_reg, unsigned int mic_sel)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(widget->dapm);
+	struct soc_enum *e = (struct soc_enum *)kcontrol->private_value;
+	unsigned int val, reg_val;
+	unsigned long affected = AVCRT_ALL_DECS;
+	bool changed;
+
+	if (dec < 0 || e->shift_l != e->shift_r || !component->regmap)
+		return affected;
+	val = snd_soc_enum_item_to_val(e, item) << e->shift_l;
+	snd_soc_dapm_mutex_lock(widget->dapm);
+	if (regmap_read(component->regmap, e->reg, &reg_val))
+		goto out;
+	changed = dapm_kcontrol_get_value(kcontrol) != val ||
+		  (reg_val & (e->mask << e->shift_l)) != val;
+	if (mic_reg) {
+		if (regmap_read(component->regmap, mic_reg, &reg_val))
+			goto out;
+		changed |= (reg_val & BIT(7)) != mic_sel;
+	}
+	affected = changed ? BIT(dec) : 0;
+out:
+	snd_soc_dapm_mutex_unlock(widget->dapm);
+	return affected;
+}
+
+/* DEC source can switch while the DEC and its capture mixer stay powered. */
+static int lpass_cdc_tx_avcrt_put_source(struct snd_kcontrol *kcontrol,
+					struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *widget = snd_soc_dapm_kcontrol_widget(kcontrol);
+	struct snd_soc_component *component = snd_soc_dapm_to_component(widget->dapm);
+	struct soc_enum *e = (struct soc_enum *)kcontrol->private_value;
+	struct lpass_cdc_tx_macro_priv *tx;
+	struct device *tx_dev;
+	unsigned int item = ucontrol->value.enumerated.item[0];
+	unsigned long affected;
+	int dec, ret;
+
+	if (item >= e->items)
+		return -EINVAL;
+	if (!lpass_cdc_tx_macro_get_data(component, &tx_dev, &tx, __func__))
+		return -EINVAL;
+
+	dec = lpass_cdc_tx_avcrt_mux_dec(e->reg, LPASS_CDC_TX_INP_MUX_ADC_MUX0_CFG1);
+	affected = lpass_cdc_tx_avcrt_enum_affected(kcontrol, widget, item, dec, 0, 0);
+	lpass_cdc_tx_avcrt_route_begin(tx, affected, kcontrol->id.name);
+	ret = snd_soc_dapm_put_enum_double(kcontrol, ucontrol);
+	lpass_cdc_tx_avcrt_route_end(tx);
+	return ret;
+}
+
+static void lpass_cdc_tx_avcrt_detach(struct lpass_cdc_tx_macro_priv *tx)
+{
+	mutex_lock(&tx->avcrt_lock);
+	if (tx->avcrt_attached) {
+		tx->avcrt_attached = false;
+		lpass_cdc_tx_avcrt_revoke(tx);
+	}
+	mutex_unlock(&tx->avcrt_lock);
+	cancel_delayed_work_sync(&tx->avcrt_mute_work);
+}
+
+static int lpass_cdc_tx_macro_avcrt_dec_mute_get(
+						struct snd_kcontrol *kcontrol,
+						struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+	struct lpass_cdc_tx_macro_priv *tx_priv;
+	struct device *tx_dev;
+
+	if (!lpass_cdc_tx_macro_get_data(component, &tx_dev, &tx_priv, __func__))
+		return -EINVAL;
+
+	mutex_lock(&tx_priv->avcrt_lock);
+	ucontrol->value.integer.value[0] = tx_priv->avcrt_dec_mute;
+	mutex_unlock(&tx_priv->avcrt_lock);
+	return 0;
+}
+
+static int lpass_cdc_tx_avcrt_lease_put(struct snd_kcontrol *kcontrol,
+					struct snd_ctl_elem_value *ucontrol,
+					bool test)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+	struct lpass_cdc_tx_macro_priv *tx;
+	struct device *tx_dev;
+	unsigned long requested = ucontrol->value.integer.value[0];
+	unsigned long *mine, other;
+	unsigned int dec;
+	int ret = 0;
+
+	if ((requested & ~GENMASK(NUM_DECIMATORS - 1, 0)) ||
+	    (test && (requested & (requested - 1))))
+		return -EINVAL;
+	if (!lpass_cdc_tx_macro_get_data(component, &tx_dev, &tx, __func__))
+		return -EINVAL;
+
+	mutex_lock(&tx->avcrt_lock);
+	if (!tx->avcrt_attached || !component->regmap) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mine = test ? &tx->avcrt_test_mute : &tx->avcrt_dec_mute;
+	other = test ? tx->avcrt_dec_mute : tx->avcrt_test_mute;
+	if (other) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!requested) {
+		bool changed = *mine != 0;
+
+		ret = lpass_cdc_tx_avcrt_revoke(tx);
+		if (!ret) {
+			tx->avcrt_revoked = false;
+			ret = changed;
+		}
+		goto out;
+	}
+	/* A late heartbeat cannot silently re-arm an expired or rerouted lease. */
+	if (*mine && time_after_eq(jiffies, tx->avcrt_mute_deadline))
+		lpass_cdc_tx_avcrt_revoke(tx);
+	if (tx->avcrt_revoked) {
+		ret = -ESTALE;
+		goto out;
+	}
+	if (tx->avcrt_ssr_down || tx->avcrt_suspended || tx->avcrt_route_updates ||
+	    (requested & ~tx->avcrt_dec_ready)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (*mine && *mine != requested) {
+		ret = -EBUSY; /* Release and revalidate before selecting another route. */
+		goto out;
+	}
+	if (!*mine) {
+		/* Don't take ownership of a mute set by the stock driver. */
+		for_each_set_bit(dec, &requested, NUM_DECIMATORS) {
+			u16 reg = LPASS_CDC_TX0_TX_PATH_CTL +
+				LPASS_CDC_TX_MACRO_TX_PATH_OFFSET * dec;
+			unsigned int val;
+
+			ret = regmap_read(component->regmap, reg, &val);
+			if (ret < 0)
+				goto out;
+			if (val & TX_PGA_MUTE_MASK) {
+				ret = -EBUSY;
+				goto out;
+			}
+		}
+		for_each_set_bit(dec, &requested, NUM_DECIMATORS) {
+			u16 reg = LPASS_CDC_TX0_TX_PATH_CTL +
+				LPASS_CDC_TX_MACRO_TX_PATH_OFFSET * dec;
+
+			/* Own even an uncertain write: it must be undone on error. */
+			set_bit(dec, mine);
+			ret = snd_soc_component_update_bits(component, reg, TX_PGA_MUTE_MASK,
+								    TX_PGA_MUTE_MASK);
+			if (ret < 0) {
+				lpass_cdc_tx_avcrt_revoke(tx);
+				goto out;
+			}
+		}
+		ret = 1;
+	}
+	tx->avcrt_mute_deadline = jiffies + msecs_to_jiffies(AVCRT_MUTE_LEASE_MS);
+	mod_delayed_work(system_wq, &tx->avcrt_mute_work,
+			 msecs_to_jiffies(AVCRT_MUTE_LEASE_MS));
+out:
+	mutex_unlock(&tx->avcrt_lock);
+	return ret;
+}
+
+static int lpass_cdc_tx_macro_avcrt_dec_mute_put(struct snd_kcontrol *kcontrol,
+						struct snd_ctl_elem_value *ucontrol)
+{
+	return lpass_cdc_tx_avcrt_lease_put(kcontrol, ucontrol, false);
+}
+
+static int lpass_cdc_tx_macro_avcrt_mute_put(struct snd_kcontrol *kcontrol,
+						   struct snd_ctl_elem_value *ucontrol)
+{
+	return lpass_cdc_tx_avcrt_lease_put(kcontrol, ucontrol, true);
+}
+
+static int lpass_cdc_tx_avcrt_lease_ms_get(struct snd_kcontrol *kcontrol,
+					   struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = AVCRT_MUTE_LEASE_MS;
+	return 0;
+}
