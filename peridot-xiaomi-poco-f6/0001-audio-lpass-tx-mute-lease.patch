+	/* This NOPM mixer updates DAPM paths directly, not the value cache. */
+	snd_soc_dapm_mutex_lock(widget->dapm);
+	snd_soc_dapm_widget_for_each_source_path(widget, path) {
+		if (path->name && !strcmp(path->name, ctl->name)) {
+			connected = path->connect;
+			matches++;
+		}
+	}
+	snd_soc_dapm_mutex_unlock(widget->dapm);
+	if (matches != 1 || connected != !!(channels & BIT(dec)))
+		return AVCRT_ALL_DECS;
+	/* Adding a previously unmuted DEC to a protected AIF is a reroute too. */
+	return connected == enable ? 0 : channels | BIT(dec);
