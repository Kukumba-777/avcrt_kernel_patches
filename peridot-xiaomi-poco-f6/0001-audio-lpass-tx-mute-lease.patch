+	mutex_lock(&tx->avcrt_lock);
+	ret = lpass_cdc_tx_avcrt_revoke(tx);
+	if (!ret)
+		tx->avcrt_suspended = true;
+	mutex_unlock(&tx->avcrt_lock);
+	if (ret)
+		return ret;
+	ret = pm_runtime_force_suspend(dev);
+	if (ret) {
+		mutex_lock(&tx->avcrt_lock);
+		tx->avcrt_suspended = false;
+		mutex_unlock(&tx->avcrt_lock);
+	}
+	return ret;
+}
