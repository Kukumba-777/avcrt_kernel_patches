+{
+	struct lpass_cdc_tx_macro_priv *tx = dev_get_drvdata(dev);
+	int ret = pm_runtime_force_resume(dev);
+
+	if (!ret) {
+		mutex_lock(&tx->avcrt_lock);
+		tx->avcrt_suspended = false;
+		mutex_unlock(&tx->avcrt_lock);
+	}
+	return ret;
